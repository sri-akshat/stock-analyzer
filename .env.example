# Copy to .env and fill in. .env is gitignored - never commit real keys.

# --- SOTA consult layer (optional; the layer stays off without a key) ---
# SA_LLM_PROVIDER=openai            # openai | anthropic
# SA_LLM_MODEL=gpt-4o
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Tunables (all have safe defaults) ---
# SA_INITIAL_CAPITAL=100000
# SA_COMMISSION_RATE=0.001
# SA_SLIPPAGE_RATE=0.0005
# SA_RISK_TOLERANCE=medium          # low | medium | high
# SA_MAX_EXPOSURE_PER_ASSET=0.20
# SA_STOP_LOSS_PCT=0.05
# SA_RISK_PER_TRADE=0.02
# SA_CACHE_DIR=.cache
